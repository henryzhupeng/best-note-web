{
  "name": "优记 BestNote",
  "short_name": "优记",
  "description": "优记 BestNote：免注册、本地存储的网页 AI 笔记，把图片、OCR 和粘贴文字整理成结构化笔记。",
  "lang": "zh-CN",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f7f7f5",
  "theme_color": "#0b4d9b",
  "icons": [
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "./icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "OCR 提取",
      "short_name": "OCR",
      "url": "./?route=ocr"
    },
    {
      "name": "示例中心",
      "short_name": "示例",
      "url": "./?route=examples"
    },
    {
      "name": "版本历史",
      "short_name": "历史",
      "url": "./?route=history"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "image",
          "accept": [
            "image/png",
            "image/jpeg",
            "image/webp",
            "image/*"
          ]
        }
      ]
    }
  }
}
